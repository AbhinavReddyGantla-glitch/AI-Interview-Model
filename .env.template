# Application Configuration
APP_NAME="AI Interview Evaluation Platform"
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1

# Database Configuration
# Formats: 
# PostgreSQL: postgresql://username:password@hostname:port/database_name
# PostgreSQL (async/asyncpg): postgresql+asyncpg://username:password@hostname:port/database_name
DATABASE_URL=postgresql://postgres:password@localhost:5432/aidatabase

# Logging Configuration
LOG_LEVEL=INFO

# API Keys (Optional in development, fallbacks are provided)
GEMINI_API_KEY=""
# Deepgram API Key (Required for high-accuracy server-side speech recognition)
DEEPGRAM_API_KEY=""
DEEPGRAM_MODEL="nova-2"
DEEPGRAM_LANGUAGE="en"

# External Integration — Coaching / Improvement Team
EXTERNAL_EVALUATION_URL="http://localhost:8000/api/v1/evaluation"
EXTERNAL_WEBHOOK_SECRET=""

# SaaS API Key (leave empty in dev to disable auth)
API_KEY=""

# Public URL for interview links
PUBLIC_BASE_URL="http://localhost:8000"
