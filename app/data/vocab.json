  "phrase_replacements": [
    {
      "pattern": "\\bscreen\\s+(university|institute|college)\\b",
      "replacement": "Sreenidhi $1",
      "case_sensitive": false
    },
    {
      "pattern": "\\bfrom\\s+screen\\b",
      "replacement": "from Sreenidhi",
      "case_sensitive": false
    },
    {
      "pattern": "\\bposting\\s+with\\s+degrees?\\b",
      "replacement": "pursuing my degree",
      "case_sensitive": false
    },
    {
      "pattern": "\\bposting\\s+(my|a|with)\\s+degree\\b",
      "replacement": "pursuing $1 degree",
      "case_sensitive": false
    },
    {
      "pattern": "\\bposting\\b(?=\\s+(my|a|degree|phd|btech|mtech))",
      "replacement": "pursuing",
      "case_sensitive": false
    },
    {
      "pattern": "\\bI'm\\s+University\\b",
      "replacement": "from University",
      "case_sensitive": false
    }
  ],
